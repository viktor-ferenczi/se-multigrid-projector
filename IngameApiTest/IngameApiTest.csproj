<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>IngameApiTest</RootNamespace>
    <AssemblyName>IngameApiTest</AssemblyName>
    <LangVersion>6</LangVersion>

    <!-- Keep existing AssemblyInfo.cs file -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Default configuration if none supplied -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <!-- Keep original behaviour for post/pre build events -->
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <AssemblyVersion>0.9.5</AssemblyVersion>
    <FileVersion>0.9.5</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>INGAME;DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>INGAME;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Script\metadata.mod" />
    <Content Include="Script\modinfo.sbmi" />
    <Content Include="Script\thumb.png" />
    <Content Include="steam_description.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpaceEngineers.ScriptingReferences" Version="1.3.0" />
  </ItemGroup>

  <Target Name="ValidateProps" BeforeTargets="PrepareForBuild">
    <Message Condition="'$(IngameScripts)' == ''"
             Text="IngameScripts is not set, the test script will not be deployed." />
    <Warning Condition="'$(IngameScripts)' != '' And !Exists('$(IngameScripts)')"
             Text="IngameScripts folder &quot;$(IngameScripts)&quot; does not exist, the test script will not be deployed." />
  </Target>

  <!-- Replaces the test script in the local in-game scripts folder, but only if the
       IngameScripts property is set (see Directory.Build.props) -->
  <Target Name="DeployScript" AfterTargets="Build"
          Condition="'$(RunPostBuildEvent)' != 'Never' And Exists('$(IngameScripts)')">
    <PropertyGroup>
      <ScriptDirectory>$(IngameScripts)$(PathSeparator)Multigrid Projector Ingame API Test</ScriptDirectory>
    </PropertyGroup>
    <ItemGroup>
      <ScriptFiles Include="Script\**" />
    </ItemGroup>

    <RemoveDir Directories="$(ScriptDirectory)" />
    <Copy SourceFiles="@(ScriptFiles)" DestinationFolder="$(ScriptDirectory)$(PathSeparator)%(RecursiveDir)" />
    <Message Importance="high" Text="Deployed the test script to &quot;$(ScriptDirectory)&quot;" />
  </Target>
</Project>
