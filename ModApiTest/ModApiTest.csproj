<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ModApiTest</RootNamespace>
    <AssemblyName>ModApiTest</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <AssemblyVersion>0.9.5</AssemblyVersion>
    <FileVersion>0.9.5</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;MOD</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Mod\Data\Scripts\MultigridProjector\Api\README.md" />
    <Content Include="Mod\metadata.mod" />
    <Content Include="Mod\modinfo.sbmi" />
    <Content Include="Mod\thumb.jpg" />
    <Content Include="steam_description.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpaceEngineers.ScriptingReferences" Version="1.3.0" />
  </ItemGroup>

  <Target Name="ValidateProps" BeforeTargets="PrepareForBuild">
    <Message Condition="'$(Mods)' == ''"
             Text="Mods is not set, the test mod will not be deployed." />
    <Warning Condition="'$(Mods)' != '' And !Exists('$(Mods)')"
             Text="Mods folder &quot;$(Mods)&quot; does not exist, the test mod will not be deployed." />
  </Target>

  <!-- Replaces the test mod in the local mods folder, completed with the API sources,
       but only if the Mods property is set (see Directory.Build.props) -->
  <Target Name="DeployMod" AfterTargets="Build"
          Condition="'$(RunPostBuildEvent)' != 'Never' And Exists('$(Mods)')">
    <PropertyGroup>
      <ModDirectory>$(Mods)$(PathSeparator)Multigrid Projector Mod API Test</ModDirectory>
      <ApiDirectory>$(ModDirectory)$(PathSeparator)Data$(PathSeparator)Scripts$(PathSeparator)MultigridProjector$(PathSeparator)Api</ApiDirectory>
    </PropertyGroup>
    <ItemGroup>
      <ModFiles Include="Mod\**" Exclude="Mod\Data\Scripts\MultigridProjector\Api\README.md" />
      <ApiFiles Include="..\MultigridProjectorApi\Api\*.cs" />
    </ItemGroup>

    <RemoveDir Directories="$(ModDirectory)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDirectory)$(PathSeparator)%(RecursiveDir)" />
    <Copy SourceFiles="@(ApiFiles)" DestinationFolder="$(ApiDirectory)" />
    <Message Importance="high" Text="Deployed the test mod to &quot;$(ModDirectory)&quot;" />
  </Target>

  <Import Project="..\MultigridProjectorApi\MultigridProjectorApi.projitems" Label="Shared" />
</Project>
